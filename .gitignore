# Migration scratch / sources (never tracked — nested git repos + scratch)
.legacy_repos/
.migration-work/

# Python / uv
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Node / pnpm (front end)
node_modules/
frontend/**/dist/
.pnpm-store/

# Editors / OS
.idea/
*.swp
.DS_Store

# Local env / secrets
.env
*.local.yaml

# pytest --debug output
pytestdebug.log
# helm chart test debug renders (belt and braces; the harness writes to deploy/tests/rendered)
rendered/
# local Claude Code state backups — never commit (contains credentials)
claude-backup/
# local Claude Code project state (skills, settings) — not part of the repo
.claude/
# Playwright traces from failed test-bed runs (diagnostics only, can be large)
testbed/.traces/
