{
  // Shared uv workspace virtualenv.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Flat pytest discovery from the repo root COLLIDES across members: every member has a
  // `tests` package and the suites do `from tests.fixtures... import ...`, which only resolves
  // when each member runs as its own pytest. So discovery is disabled for the root folder.
  //
  // >>> Open `ghga.code-workspace` (File > Open Workspace from File) for working per-member
  //     test discovery: each member is a folder that runs its own pytest, so imports resolve. <<<
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,

  // Copilot finds the root `AGENTS.md` by itself, but the nested ones only with this.
  "chat.useNestedAgentsMdFiles": true,

  // Markdown is one sentence per line (ADR-0044), so long lines are read soft-wrapped.
  "[markdown]": {
    "editor.wordWrap": "on"
  },

  "search.exclude": {
    ".legacy_repos/**": true,
    ".migration-work/**": true,
    "**/.venv/**": true
  },
  "files.exclude": {
    ".migration-work": true
  }
}
