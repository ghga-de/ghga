{
  // Shared uv workspace virtualenv.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Flat pytest discovery from the repo root COLLIDES across members: every member has a
  // `tests` package and the suites do `from tests.fixtures... import ...`, which only resolves
  // when each member runs as its own pytest. So discovery is disabled for the root folder.
  //
  // >>> Open `ghga.code-workspace` (File > Open Workspace from File) for working per-member
  //     test discovery: each member is a folder that runs its own pytest, so imports resolve. <<<
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,

  // Copilot finds the root `AGENTS.md` by itself, but the nested ones only with this.
  "chat.useNestedAgentsMdFiles": true,
  // Lets chat agents open and inspect pages in the integrated browser, such as the demo's
  // data portal.
  "workbench.browser.enableChatTools": true,

  // The fixes the trailing-whitespace and end-of-file-fixer hooks make, applied on save.
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Markdown is one sentence per line (ADR-0044), so long lines are read soft-wrapped.
  // Trailing spaces stay, as the hook keeps them as hard line breaks.
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  },

  // Ruff is the Python formatter and linter (mirrors `just fmt`).
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Some YAML files, such as the metldata test models and the front end's pnpm-lock.yaml,
  // exceed the default outline limit of 5000 items.
  "yaml.maxItemsComputed": 15000,

  "search.exclude": {
    ".legacy_repos/**": true,
    ".migration-work/**": true,
    "**/.venv/**": true,
    // symlinks to skills under .agents/skills or a library's src: searching through
    // them would show every hit twice and bypass the .gitignore patterns, which
    // match the real path only
    "**/.claude/skills/**": true,
    ".agents/skills/hexkit/**": true
  },
  "files.exclude": {
    ".migration-work": true
  }
}
