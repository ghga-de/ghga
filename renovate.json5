{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',
  labels: [
    'dependencies',
    'docker-base-image',
  ],
  enabledManagers: [
    'custom.regex',
  ],
  vulnerabilityAlerts: {
    enabled: false,
  },
  dependencyDashboard: {
    header: "**Renovate writes this issue — edit it by hand and the next run overwrites you.** It is rebuilt by `.github/workflows/renovate.yaml`, weekly on Mondays at 05:17 UTC or on demand via that workflow's *Run workflow* button, so between runs the lists below lag reality — a PR merged or closed since the last run is still listed as open here. The [Dependency Dashboard](https://docs.renovatebot.com/key-concepts/dashboard/) docs explain what the checkboxes do.\n\nRenovate's scope in this repository is deliberately narrow: the DHI base-image tags in `docker/Dockerfile` and `frontend/data-portal/Dockerfile`, and the digest-pinned Chainguard MinIO images in `deploy/charts/ghga-demo/values.yaml`. The application dependency lockfiles (`uv.lock`, `pnpm-lock.yaml`) are handled by the daily `security-scan.yaml` workflow instead, and Dependabot alerts along with them. See `renovate.json5` for the full configuration.\n\nDependencies deliberately kept behind their latest version are listed with the signal to update in [docs/dependencies.md](https://github.com/ghga-de/ghga/blob/dev/docs/dependencies.md#held-back-versions); review it when you look at this issue.",
  },
  packageRules: [
    {
      groupName: 'dhi.io Python base image',
      matchDepNames: [
        'dhi.io/python',
      ],
    },
    {
      groupName: 'dhi.io Node base image',
      matchDepNames: [
        'dhi.io/node',
      ],
    },
    {
      matchDepNames: [
        'dhi.io/python',
        'dhi.io/node',
      ],
      automerge: false,
    },
    {
      matchDepNames: [
        'dhi.io/python',
      ],
      allowedVersions: '/^3\\.14\\./',
    },
    {
      matchDepNames: [
        'dhi.io/node',
      ],
      allowedVersions: '/^24\\./',
    },
    {
      groupName: 'Chainguard MinIO images',
      matchDepNames: [
        'cgr.dev/chainguard/minio',
        'cgr.dev/chainguard/minio-client',
      ],
      allowedVersions: '/^latest$/',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'dhi.io/python base image tag (docker/Dockerfile)',
      managerFilePatterns: [
        '/^docker/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: track=python-base\\s+ARG PYTHON_BASE=(?<currentValue>[\\w.-]+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'dhi.io/python',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'dhi.io/node base image tag (frontend/data-portal/Dockerfile)',
      managerFilePatterns: [
        '/^frontend/data-portal/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: track=node-base\\s+ARG NODE_BASE=(?<currentValue>[\\w.-]+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'dhi.io/node',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Chainguard MinIO images, pinned by digest (deploy/charts/ghga-demo/values.yaml)',
      managerFilePatterns: [
        '/^deploy/charts/ghga-demo/values\\.yaml$/',
      ],
      matchStrings: [
        'image: (?<depName>cgr\\.dev/chainguard/minio):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]+)',
        'mcImage: (?<depName>cgr\\.dev/chainguard/minio-client):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
}
