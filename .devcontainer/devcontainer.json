{
  "name": "Python & Claude",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "customizations": {
    "vscode": {
      // One shared environment for both stacks: Python (services/libs/tools) and the
      // Angular front end (frontend/data-portal). Extensions activate per file type, so
      // Pylance/ruff run on .py while the Angular Language Service, ESLint, Prettier, and
      // the Vitest/Playwright test explorers run in data-portal — all in one window.
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        // vitest.explorer omitted on purpose: Angular 22 runs unit tests via the
        // @angular/build:unit-test builder, which the plain-Vitest extension can't
        // drive (no VS Code Testing integration). Use `pnpm test` / `pnpm test:ui`.
        "ms-playwright.playwright",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  // Angular dev server (data-portal serves on 8080, not the ng default 4200; API is mocked
  // in-browser via MSW, so no backend is required to run it).
  "forwardPorts": [8080],
  // Persist uv's managed Python interpreters and its wheel cache across rebuilds.
  // The workspace .venv lives on the (surviving) bind mount but symlinks its interpreter
  // into ~/.local/share/uv/python/...; without this volume a rebuild wipes that target and
  // the venv symlink dangles (breaking pytest discovery). Persisting ~/.cache/uv additionally
  // skips re-downloading/rebuilding every dependency wheel on each rebuild.
  // Persisted across rebuilds: uv interpreters + wheel cache (see above), and the Playwright
  // browser binaries (~100MB+ each) so E2E tests don't re-download them on every rebuild.
  "mounts": [
    "source=ghga-claude,target=/home/vscode/.claude,type=volume",
    "source=ghga-uv-data,target=/home/vscode/.local/share/uv,type=volume",
    "source=ghga-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=ghga-playwright,target=/home/vscode/.cache/ms-playwright,type=volume"
  ],
  // Fresh named volumes mount root-owned, and Docker also creates their parent dirs
  // (~/.local, ~/.local/share, ~/.cache) root-owned — which blocks `uv tool install` from
  // creating ~/.local/bin and Playwright from creating ~/.cache/ms-playwright. Chown the
  // parents AND the volume contents to vscode, install the migration tooling (git-filter-repo,
  // also lost on rebuild), then provision BOTH stacks: the Python workspace venv (uv), the
  // front-end node_modules (pnpm), and the Playwright browsers — so pytest discovery, the
  // Angular tooling, and the E2E tests all work the moment the window opens.
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.local /home/vscode/.local/share /home/vscode/.cache && sudo chown -R vscode:vscode /home/vscode/.local/share/uv /home/vscode/.cache/uv /home/vscode/.cache/ms-playwright && uv tool install --reinstall git-filter-repo && uv sync --all-packages --all-extras && (cd frontend/data-portal && pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium)"
}
