{
  "name": "data-portal",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "GHGA Data Portal - the web front end for browsing metadata, submitting and uploading datasets, requesting access to, and downloading GHGA-hosted data.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:watch": "tsc -b -w --pretty false",
    "typecheck:ng": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lf": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false && pnpm test:run",
    "test:run": "node --test run.test.js",
    "test:watch": "ng test",
    "test:ui": "ng test --ui --runner-config vitest.ui.config.ts",
    "e2e": "playwright test --project chromium",
    "e2e:all": "playwright test --workers=2",
    "e2e:debug": "playwright test --project chromium --debug",
    "e2e:headed": "playwright test --project chromium --headed",
    "e2e:ui": "playwright test --project chromium --ui",
    "e2e:report": "playwright show-report --host 0.0.0.0",
    "preinstall": "npx only-allow pnpm",
    "docs": "compodoc -p tsconfig.doc.json -s -r 8081",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s -r 8081",
    "compodoc:serve": "compodoc -s",
    "toc": "markdown-toc-gen update README.md"
  },
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/material-date-fns-adapter": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngneat/cashew": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angularx-qrcode": "^22.0.1",
    "date-fns": "^4.4.0",
    "js-yaml": "^5.5.0",
    "ngx-mat-input-tel": "^22.1.1",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "jsdom": "^30.1.3",
    "markdown-toc-gen": "^1.2.0",
    "msw": "^3.0.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "src/mocks"
    ]
  }
}
