# Per-developer settings for the local dev server, mainly the secrets that must not be
# committed. Copy to local.env (gitignored) and uncomment what you need; `just fe-dev`
# and friends read it, and everything in it also becomes a real environment variable.
#
# Every key of data-portal.default.yaml can be set here as data_portal_<key>, so this
# overrides both the defaults and data-portal.dev.yaml.

# backend to proxy the API to in --with-backend mode
# data_portal_base_url=https://data.staging.ghga.dev

# credentials, if that backend is behind Basic authentication
# data_portal_basic_auth=USERNAME:PASSWORD

# skip TLS verification when proxying to a backend with a self-signed certificate
# (read by proxy.conf.mjs, not a settings key)
# data_portal_ignore_cert=1

# client registered with the OIDC provider, for --with-oidc mode
# data_portal_oidc_client_id=THE_OIDC_CLIENT_ID

# analytics, normally left off during development
# data_portal_umami_url=https://umami.foundational.staging.ghga.dev/umami
# data_portal_umami_website_id=the-website-id
